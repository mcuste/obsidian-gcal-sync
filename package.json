{
  "name": "obsidian-gcloud",
  "version": "0.1.0",
  "description": "Sync Google Calendar events declared in an Obsidian vault.",
  "type": "module",
  "main": "main.js",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc --noEmit --skipLibCheck && node esbuild.config.mjs production",
    "test": "tsx --test tests/**/*.test.ts"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "esbuild": "0.28.2",
    "obsidian": "1.13.1",
    "tsx": "4.23.12",
    "typescript": "7.0.2"
  },
  "packageManager": "pnpm@11.22.0"
}

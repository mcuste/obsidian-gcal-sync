{
  "name": "obsidian-gcal-sync",
  "version": "0.3.1",
  "description": "Sync Google Calendar events declared in an Obsidian vault.",
  "type": "module",
  "main": "main.js",
  "scripts": {
    "build": "tsc --noEmit --skipLibCheck && node esbuild.config.mjs production",
    "check": "pnpm quality && pnpm test && pnpm deadcode && pnpm security && pnpm build",
    "deadcode": "knip",
    "dev": "node esbuild.config.mjs",
    "fix": "biome check --write .",
    "format": "biome format --write .",
    "lint": "biome lint .",
    "quality": "biome check .",
    "release": "node release.mjs",
    "security": "pnpm audit --audit-level high",
    "test": "tsx --tsconfig tests/tsconfig.json --test tests/**/*.test.ts",
    "version": "node version-bump.mjs && git add manifest.json versions.json"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.9",
    "@codemirror/state": "^6.7.1",
    "@codemirror/view": "^6.43.9",
    "@types/node": "^26.2.0",
    "esbuild": "0.28.2",
    "knip": "6.32.2",
    "obsidian": "1.13.1",
    "tsx": "4.23.12",
    "typescript": "7.0.2"
  },
  "knip": {
    "entry": [
      "tests/**/*.test.ts",
      "tests/obsidian-stub.ts"
    ],
    "project": [
      "src/**/*.ts",
      "tests/**/*.ts",
      "*.mjs"
    ]
  },
  "packageManager": "pnpm@11.22.0"
}
